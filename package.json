{
  "name": "qa-panel",
  "version": "1.1.0",
  "private": true,
  "main": "public/electron.js",
  "dependencies": {
    "active-win": "^8.1.0",
    "electron-is-dev": "^2.0.0",
    "electron-log": "^5.0.0-beta.16",
    "electron-updater": "^5.3.0",
    "qa-panel": "file:",
    "react": "^17.0.2",
    "react-dom": "^17.0.2"
  },
  "devDependencies": {
    "electron": "^23.1.3",
    "electron-builder": "^23.6.0"
  },
  "scripts": {
    "start": "electron .",
    "build": "electron-builder build --win --publish never"
  },
  "build": {
    "appId": "com.electron.qa-panel",
    "productName": "QA Panel",
    "files": [
      "build/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "public"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/app-icon.png"
    }
  }
}
