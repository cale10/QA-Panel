{
  "name": "qa-panel",
  "version": "1.1.0",
  "description": "A floating QA panel for applications",
  "main": "public/electron.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "test": "echo \"Error: no test specified\" && exit 1",
    "check:ollama": "node public/services/ollama-endpoint-check.js"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "active-win": "^8.1.1",
    "electron-is-dev": "^2.0.0",
    "electron-log": "^5.0.1",
    "node-fetch": "2.6.7",
    "qa-panel": "file:"
  },
  "build": {
    "appId": "com.qa-panel.app",
    "mac": {
      "category": "public.app-category.utilities"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
